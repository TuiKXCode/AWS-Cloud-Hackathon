{
  "name": "mandai-echoes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mandai Echoes — Mandai Wildlife Reserve companion app (Phases 1–7)",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:offline": "vite build --config vite.config.offline.ts && node scripts/build-offline.mjs"
  },
  "dependencies": {
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "fast-check": "^3.22.0",
    "jsdom": "^25.0.1",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "^5.6.2",
    "vite": "5.4.21",
    "vitest": "^2.1.2"
  }
}
